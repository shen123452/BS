page { height: 100%; overflow: hidden; }
.qa-page { height: 100%; display: flex; flex-direction: column; background: var(--color-canvas); }
.qa-toolbar { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 10rpx 16rpx 10rpx 24rpx; background: var(--color-surface); border-bottom: 1rpx solid var(--color-border); }
.qa-toolbar-title { font-size: 24rpx; color: var(--color-ink-muted); }
.qa-tools { display: flex; align-items: center; }
.qa-toolbar .text-button { font-size: 24rpx; padding: 0 8rpx; }
.chat-scroll { flex: 1; min-height: 0; height: 0; box-sizing: border-box; padding: 0 24rpx; }
.knowledge-hint { padding: 16rpx 0; font-size: 24rpx; line-height: 1.7; color: var(--color-ink-muted); }
.qa-welcome { padding: 48rpx 8rpx 40rpx; }
.qa-welcome-title { font-size: 36rpx; line-height: 1.35; font-weight: 600; }
.qa-welcome-copy { margin-top: 12rpx; font-size: 24rpx; line-height: 1.7; color: var(--color-ink-muted); }
.question-suggestions { margin-top: 28rpx; display: flex; flex-direction: column; gap: 12rpx; }
.suggestion-button { background: var(--color-surface); color: var(--color-ink); border: 1rpx solid var(--color-border); font-size: 25rpx; line-height: 1.5; padding: 18rpx 20rpx; min-height: 88rpx; border-radius: 8rpx; text-align: left; margin: 0; }
.suggestion-button::after { border: none; }
.msg-row { margin: 24rpx 0; display: flex; flex-direction: column; }
.row-user { align-items: flex-end; }
.row-assistant { align-items: stretch; }
.msg-author { font-size: 24rpx; line-height: 1.5; color: var(--color-ink-muted); margin-bottom: 6rpx; }
.msg-bubble { max-width: 100%; box-sizing: border-box; padding: 16rpx 20rpx; border-radius: 8rpx; font-size: 27rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
.bubble-user { max-width: 86%; background: var(--color-primary); color: #FFFFFF; }
.bubble-assistant { width: 100%; padding: 18rpx 20rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); }
.message-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 8rpx; }
.mode-label { font-size: 24rpx; color: var(--color-ink-muted); }
.source-button { font-size: 24rpx; padding: 0; }
.chat-composer { flex-shrink: 0; background: var(--color-surface); border-top: 1rpx solid var(--color-border); padding: 14rpx 20rpx calc(10rpx + env(safe-area-inset-bottom)); }
.qa-tab .chat-composer { padding-bottom: 10rpx; }
.chat-input-bar { display: flex; align-items: center; gap: 10rpx; }
.chat-input { flex: 1; width: 0; min-width: 0; height: 76rpx; box-sizing: border-box; padding: 0 18rpx; background: var(--color-canvas); border: 1rpx solid var(--color-border); border-radius: 8rpx; font-size: 26rpx; }
.chat-send { flex: 0 0 112rpx; width: 112rpx; min-height: 88rpx; margin: 0; padding: 0 8rpx; font-size: 25rpx; }
.composer-note { font-size: 24rpx; line-height: 1.6; color: var(--color-ink-faint); text-align: center; margin-top: 6rpx; }
.chat-error { margin: 18rpx 0; }
.reload-button { margin: 16rpx 0; font-size: 24rpx; }
.scroll-anchor { height: 20rpx; }
.chat-status { padding: 24rpx 0; color: var(--color-ink-muted); font-size: 24rpx; }
.source-backdrop { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 20; background: rgba(16, 24, 40, .45); display: flex; align-items: flex-end; }
.source-sheet { width: 100%; height: 76%; display: flex; flex-direction: column; background: var(--color-surface); border-radius: 16rpx 16rpx 0 0; padding-bottom: env(safe-area-inset-bottom); }
.source-sheet-heading { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 20rpx 12rpx 24rpx; border-bottom: 1rpx solid var(--color-border); }
.source-sheet-heading .card-title { margin: 0; font-size: 28rpx; }
.source-scroll { flex: 1; height: 0; min-height: 0; padding: 0 24rpx; box-sizing: border-box; }
.source-item { padding: 22rpx 0; border-bottom: 1rpx solid var(--color-border); }
.source-index { font-size: 24rpx; color: var(--color-primary); }
.source-title { font-size: 26rpx; font-weight: 600; margin-top: 4rpx; }
.source-origin { margin-top: 6rpx; font-size: 24rpx; line-height: 1.6; color: var(--color-ink-muted); }
.source-excerpt { display: block; white-space: pre-wrap; font-size: 25rpx; line-height: 1.8; margin-top: 12rpx; }
.source-copy { justify-content: flex-start; padding: 0; margin-top: 8rpx; }
.qa-page button.chat-send { width: 112rpx; margin: 0; padding: 0 8rpx; }
.qa-page button.suggestion-button { width: auto; max-width: 100%; }

.bubble-assistant { width:100%;padding:24rpx;background:var(--color-surface);border:0;border-radius:24rpx; }
.source-excerpt { font-size:28rpx;padding:24rpx;background:var(--color-canvas);border-radius:16rpx; }
.chat-input,.chat-send { min-height:88rpx;font-size:28rpx; }
