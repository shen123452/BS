page { background:#FFFFFF; }
.login-page { min-height:100vh;padding:0 62rpx calc(36rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;box-sizing:border-box;background:#FFFFFF; }
.login-hero { display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;min-height:640rpx;padding:52rpx 0 70rpx;box-sizing:border-box; }
.login-logo { width:120rpx;height:164rpx; }
.brand-name { margin-top:44rpx;font-size:54rpx;line-height:1.4;font-weight:600;letter-spacing:2rpx; }
.brand-description { margin-top:22rpx;font-size:30rpx;color:var(--color-ink-muted); }
.login-actions { width:100%;padding:18rpx 0; }
.login-status { margin:0 0 24rpx;font-size:28rpx;text-align:center;color:var(--color-ink-muted); }
.login-status.form-error { color:var(--color-danger); }
.login-submit { min-height:104rpx;border-radius:28rpx;font-size:30rpx; }
button.login-submit[disabled] { opacity:1;background:#DFE9FA;color:#647BA4; }
.login-agreements { margin-top:130rpx;text-align:center; }
.consent-row { display:flex;align-items:center;justify-content:center;min-height:88rpx;font-size:28rpx;color:var(--color-ink-muted); }
.consent-row checkbox { transform:scale(.78);flex-shrink:0; }
.agreement-links { display:flex;align-items:center;justify-content:center;font-size:28rpx;gap:6rpx; }
.agreement-links .text-button { font-size:28rpx;min-height:88rpx;padding:0; }
.login-footer { margin-top:54rpx;font-size:27rpx;line-height:1.7;color:var(--color-ink-faint); }
