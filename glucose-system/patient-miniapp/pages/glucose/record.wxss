.record-page > .card { background: transparent; border: 0; padding: 0; box-shadow: none; }
.record-page .page-title { font-size: 40rpx; font-weight: 700; color: var(--color-ink); }
.record-page .form-input { width: 100%; }
.record-page .form-item {
  background: var(--color-surface); padding: 28rpx; border-radius: 28rpx; margin-bottom: 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.85); box-shadow: var(--shadow-card);
}
.glucose-value-field { display: flex; align-items: baseline; }
.glucose-input {
  flex: 1; min-width: 0; font-size: 72rpx; line-height: 1; font-weight: 800;
  min-height: 110rpx; border: 0; padding: 8rpx 0; color: var(--color-ink);
  letter-spacing: -0.03em;
}
.chip-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 8rpx; }
.chip {
  padding: 16rpx 8rpx; background: #F8FAFC; border: 1rpx solid #E2E8F0;
  min-height: 88rpx; border-radius: 16rpx; font-weight: 500;
  transition: all 0.15s ease;
}
.chip-active {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF; border-color: transparent; font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.25);
}
.form-item:nth-child(3) .chip-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.custom-time { margin-top: 18rpx; }
.picker-input {
  min-height: 88rpx; padding: 14rpx 20rpx; font-size: 27rpx; display: flex; align-items: center;
  border-radius: 14rpx; border: 1rpx solid #CBD5E1; background: #F8FAFC;
}
.submit-button { margin-top: 24rpx; min-height: 96rpx; font-size: 32rpx; font-weight: 700; border-radius: 24rpx; }

/* 成功反馈浮层卡片 */
.success-sheet {
  background: var(--color-surface); border-radius: 32rpx; padding: 56rpx 36rpx;
  text-align: center; margin-top: 50rpx; box-shadow: var(--shadow-card-elevated);
  border: 1rpx solid #E2E8F0;
}
.success-line { color: var(--color-success); font-size: 40rpx; font-weight: 800; letter-spacing: -0.01em; }
.success-reading { display: flex; align-items: baseline; justify-content: center; margin: 32rpx 0 20rpx; }
.success-reading .number { font-size: 80rpx; font-weight: 800; color: var(--color-ink); }
.success-alert { margin-top: 22rpx; display: inline-flex; }
.success-note { margin-top: 14rpx; font-size: 24rpx; color: var(--color-ink-faint); }
.success-actions { display: flex; flex-direction: column; gap: 20rpx; margin-top: 50rpx; }
