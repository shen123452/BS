page {
  background-color: #F4F7FB;
}

.records-page {
  min-height: 100vh;
  background-color: #F4F7FB;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部统一操作与筛选面板 */
.records-header {
  background: #FFFFFF;
  padding: 20rpx 28rpx 22rpx;
  border-bottom: 1rpx solid #EEF2F7;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.record-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.record-toolbar button {
  margin: 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.secondary-btn {
  background: #F8FAFC;
  color: #1E293B;
  border: 1rpx solid #E2E8F0;
  box-shadow: none;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 三段来源切换器 */
.source-tabs {
  display: flex;
  background: #F1F5F9;
  padding: 6rpx;
  border-radius: 16rpx;
}

.source-tab {
  flex: 1;
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #64748B;
  border-radius: 12rpx;
  transition: all 0.18s ease;
}

.source-tab-active {
  background: #FFFFFF;
  color: #2563EB;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.07);
}

/* 日期与条数栏 */
.filter-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.date-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 9999rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  font-size: 24rpx;
  font-weight: 500;
  color: #334155;
}

.date-pill-active {
  background: #EFF6FF;
  border-color: #BFDBFE;
  color: #1D4ED8;
  font-weight: 600;
}

.date-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.clear-pill {
  height: 54rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 9999rpx;
  background: #F1F5F9;
  color: #64748B;
  font-size: 23rpx;
  font-weight: 500;
}

.record-total {
  font-size: 24rpx;
  color: #64748B;
}

.total-num {
  font-weight: 700;
  color: #0F172A;
}

/* 列表主体 */
.records-body {
  padding: 24rpx 28rpx 0;
}

.state-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
}

/* 空状态 */
.empty-state {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 72rpx 36rpx 56rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
}

.empty-badge {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 25rpx;
  color: #64748B;
  line-height: 1.6;
}

.empty-cta {
  width: auto;
  display: inline-flex;
  margin-top: 32rpx;
  padding: 0 40rpx;
  min-height: 80rpx;
  border-radius: 9999rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  color: #1D4ED8;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: none;
}

/* 记录卡片列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.045);
}

.record-accent {
  width: 8rpx;
  flex-shrink: 0;
}

.accent-primary { background: #2563EB; }
.accent-info { background: #0284C7; }
.accent-danger { background: #EF4444; }

.record-content {
  flex: 1;
  min-width: 0;
  padding: 24rpx 26rpx 20rpx;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-time {
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.45;
}

.record-type {
  font-weight: 600;
  color: #334155;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.mini-tag {
  font-size: 21rpx;
  font-weight: 600;
  padding: 3rpx 14rpx;
  border-radius: 9999rpx;
}

.mini-tag-smbg {
  color: #1D4ED8;
  background: #EFF6FF;
}

.mini-tag-cgm {
  color: #0369A1;
  background: #F0F9FF;
}

.mini-tag-danger {
  color: #DC2626;
  background: #FEF2F2;
}

.mini-tag-batch {
  color: #6D28D9;
  background: #F3E8FF;
}

.record-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #64748B;
}

.record-value {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.value-num {
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #0F172A;
  letter-spacing: -0.02em;
}

.value-danger {
  color: #DC2626;
}

.value-unit {
  font-size: 21rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

.record-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F1F5F9;
}

.row-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #2563EB;
  padding: 6rpx 10rpx;
}

.row-action-sep {
  width: 1rpx;
  height: 24rpx;
  background: #E2E8F0;
}

.row-action-danger {
  color: #DC2626;
}

.load-more {
  margin-top: 24rpx;
}
