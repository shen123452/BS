page {
  height: 100%;
  overflow: hidden;
  background-color: #F4F7FB;
}

.qa-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #F4F7FB;
}

/* 顶部对话栏 */
.qa-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 14rpx 24rpx 14rpx 28rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEF2F7;
}

.qa-toolbar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.toolbar-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #CBD5E1;
  flex-shrink: 0;
}

.dot-active {
  background: #10B981;
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.16);
}

.qa-toolbar-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #0F172A;
}

.qa-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.qa-toolbar .toolbar-pill {
  min-height: 60rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1D4ED8;
  background: #EFF6FF;
  border-radius: 9999rpx;
}

.qa-toolbar .toolbar-pill[disabled] {
  background: #F1F5F9;
  color: #94A3B8;
  opacity: 1;
}

/* 滚动对话区域 */
.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.knowledge-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 22rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #1E40AF;
  background: #EFF6FF;
  border-radius: 18rpx;
  border: 1rpx solid #DBEAFE;
}

.hint-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.hint-text {
  flex: 1;
  min-width: 0;
}

/* 欢迎空状态 */
.qa-welcome {
  padding: 24rpx 0 36rpx;
}

.welcome-hero {
  background: linear-gradient(145deg, #E8F2FF 0%, #FFFFFF 72%);
  border: 1rpx solid #DBEAFE;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 26rpx;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.06);
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.hero-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-badge-icon {
  width: 50rpx;
  height: 50rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.qa-welcome-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #0F172A;
}

.qa-welcome-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #475569;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(191, 219, 254, 0.65);
}

.hero-chip {
  font-size: 22rpx;
  font-weight: 500;
  color: #1D4ED8;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #DBEAFE;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
}

/* 推荐问题卡片 */
.suggestions-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
  overflow: hidden;
}

.suggestions-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
}

.suggestions-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.suggestions-sub {
  font-size: 23rpx;
  color: #94A3B8;
}

.question-suggestions {
  display: flex;
  flex-direction: column;
}

.suggestion-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}

.suggestion-row-hover {
  background: #F8FAFC;
}

.suggestion-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.suggestion-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #1E293B;
}

.suggestion-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.suggestion-divider {
  height: 1rpx;
  background: #F1F5F9;
  margin-left: 84rpx;
}

/* 对话消息流 */
.msg-row {
  margin: 28rpx 0;
  display: flex;
  flex-direction: column;
}

.row-user {
  align-items: flex-end;
}

.row-assistant {
  align-items: stretch;
}

.msg-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.msg-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-ai {
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
}

.avatar-doctor {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
}

.msg-avatar-icon {
  width: 26rpx;
  height: 26rpx;
}

.msg-avatar-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.msg-author {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}

.msg-author-user {
  color: #94A3B8;
  font-weight: 500;
  margin-bottom: 8rpx;
  margin-right: 6rpx;
}

.mode-pill {
  font-size: 21rpx;
  font-weight: 600;
  color: #1D4ED8;
  background: #EFF6FF;
  padding: 2rpx 14rpx;
  border-radius: 9999rpx;
}

.mode-pill-human {
  color: #047857;
  background: #ECFDF5;
}

.msg-bubble {
  max-width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-user {
  max-width: 84%;
  padding: 20rpx 26rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, 0.22);
  font-weight: 500;
}

.bubble-assistant {
  width: 100%;
  padding: 26rpx 28rpx;
  background: #FFFFFF;
  border-radius: 10rpx 28rpx 28rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
  color: #0F172A;
}

.processing-copy {
  color: #64748B;
  font-size: 26rpx;
}

.stream-cursor {
  color: #2563EB;
  margin-left: 4rpx;
  animation: stream-blink 1s steps(2, start) infinite;
}

@keyframes stream-blink {
  to { visibility: hidden; }
}

.message-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.source-button {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 9999rpx;
  background: #FFFFFF;
  border: 1rpx solid #DBEAFE;
  font-size: 24rpx;
  font-weight: 600;
  color: #1D4ED8;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.06);
}

.source-btn-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

/* 底部输入工具栏 */
.chat-composer {
  flex-shrink: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #EEF2F7;
  padding: 16rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 18rpx rgba(15, 23, 42, 0.03);
}

.qa-tab .chat-composer {
  padding-bottom: 14rpx;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.chat-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  background: #F4F7FB;
  border: 1rpx solid #E2E8F0;
  border-radius: 9999rpx;
  font-size: 28rpx;
  color: #0F172A;
}

.chat-input:focus {
  border-color: var(--color-primary);
  background: #FFFFFF;
}

.chat-send {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  font-size: 27rpx;
  font-weight: 700;
  border-radius: 9999rpx;
}

.qa-page button.chat-send {
  width: 132rpx;
  margin: 0;
}

.composer-note {
  font-size: 22rpx;
  line-height: 1.5;
  color: #94A3B8;
  text-align: center;
  margin-top: 10rpx;
}

.chat-error {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 16rpx;
}

.reload-button {
  margin: 18rpx 0;
  font-size: 25rpx;
}

.scroll-anchor {
  height: 24rpx;
}

.chat-status {
  padding: 36rpx 0;
  color: #64748B;
  font-size: 25rpx;
  text-align: center;
}

/* 引用资料弹出半屏 */
.source-backdrop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.source-sheet {
  width: 100%;
  height: 76%;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 36rpx rgba(15, 23, 42, 0.14);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #E2E8F0;
  margin: 16rpx auto 4rpx;
  flex-shrink: 0;
}

.source-sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.source-sheet-heading .card-title {
  margin: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.source-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.source-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.source-item-top {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.source-index {
  font-size: 24rpx;
  font-weight: 700;
  color: #2563EB;
  flex-shrink: 0;
}

.source-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.source-origin {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #64748B;
}

.source-excerpt {
  display: block;
  white-space: pre-wrap;
  font-size: 26rpx;
  line-height: 1.8;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  border-left: 6rpx solid #3B82F6;
  color: #1E293B;
}

.source-copy {
  justify-content: flex-start;
  padding: 0;
  margin-top: 10rpx;
  font-size: 24rpx;
}
