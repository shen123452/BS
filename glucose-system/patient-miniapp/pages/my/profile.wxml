<view class="sub-page">
  <view wx:if="{{errorMsg}}" class="state-card">
    <view class="form-error">{{errorMsg}}</view>
    <button class="btn-plain mt" bindtap="load">重新加载</button>
  </view>
  <view wx:elif="{{loading && !profile}}" class="state-card muted">正在加载个人资料…</view>

  <block wx:elif="{{profile}}">
    <view class="identity-card">
      <view class="identity-avatar">
        <text wx:if="{{avatarInitial}}" class="avatar-initial">{{avatarInitial}}</text>
        <image wx:else class="avatar-icon" src="/assets/icons/avatar-user.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="identity-info">
        <view class="identity-name">{{profileForm.realName || profile.username || '微信用户'}}</view>
        <view class="identity-id">账号 ID: {{accountId}}</view>
      </view>
    </view>

    <view class="form-card">
      <view class="form-item">
        <label class="form-label">姓名（选填）</label>
        <input class="form-input" value="{{profileForm.realName}}" placeholder="请输入姓名或昵称" maxlength="50" data-field="realName" bindinput="onProfileInput" />
      </view>

      <view class="form-item">
        <label class="form-label">手机号（选填）</label>
        <input class="form-input" value="{{profileForm.phone}}" placeholder="请输入 11 位手机号" maxlength="20" type="number" data-field="phone" bindinput="onProfileInput" />
      </view>

      <view class="form-item">
        <view class="form-label">性别（选填）</view>
        <picker range="{{genders}}" value="{{profileForm.gender}}" bindchange="onGender">
          <view class="form-input picker-field">
            <text class="{{profileForm.gender === 0 ? 'placeholder-text' : ''}}">{{genders[profileForm.gender]}}</text>
            <image class="picker-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
          </view>
        </picker>
      </view>

      <view class="form-item">
        <view class="label-row">
          <view class="form-label">出生日期（选填）</view>
          <text wx:if="{{profileForm.birthDate}}" class="clear-link" bindtap="clearBirthDate">清空</text>
        </view>
        <picker mode="date" value="{{profileForm.birthDate}}" data-field="birthDate" bindchange="onProfileInput">
          <view class="form-input picker-field">
            <text class="{{!profileForm.birthDate ? 'placeholder-text' : ''}}">{{profileForm.birthDate || '选择出生日期'}}</text>
            <image class="picker-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
          </view>
        </picker>
      </view>

      <view class="form-item form-item-last">
        <label class="form-label">糖尿病类型（选填）</label>
        <view class="preset-chips">
          <view wx:for="{{diabetesPresets}}" wx:key="*this" class="preset-chip {{profileForm.diabetesType === item ? 'preset-chip-active' : ''}}" data-value="{{item}}" bindtap="pickDiabetesPreset">{{item}}</view>
        </view>
        <input class="form-input mt-sm" value="{{profileForm.diabetesType}}" placeholder="或手动输入其他类型" maxlength="20" data-field="diabetesType" bindinput="onProfileInput" />
      </view>

      <view wx:if="{{profileError}}" class="form-error form-error-box">{{profileError}}</view>
    </view>

    <view class="bottom-actions">
      <button class="btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button>
    </view>
  </block>
</view>
