page {
  background-color: #F4F7FB;
}

.sub-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
}

.identity-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.2);
}

.avatar-initial {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.avatar-icon {
  width: 50rpx;
  height: 50rpx;
}

.identity-info {
  flex: 1;
  min-width: 0;
}

.identity-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-id {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.form-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
}

.form-item-last {
  margin-bottom: 4rpx;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label-row .form-label {
  margin-bottom: 0;
}

.clear-link {
  font-size: 25rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 4rpx 8rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.placeholder-text {
  color: #94A3B8;
}

.picker-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.preset-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.preset-chip {
  padding: 10rpx 22rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #475569;
  background: #F1F5F9;
  border: 1rpx solid transparent;
}

.preset-chip-active {
  color: #1D4ED8;
  background: #EFF6FF;
  border-color: #93C5FD;
  font-weight: 600;
}

.mt-sm {
  margin-top: 8rpx;
}

.form-error-box {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 14rpx;
}

.bottom-actions {
  margin-top: 32rpx;
}
