page {
  background-color: #F4F7FB;
}

.home-page {
  min-height: 100vh;
  background-color: #F4F7FB;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部渐进浅蓝头图区 */
.home-hero {
  background: linear-gradient(180deg, #DCEEFF 0%, #EEF6FF 58%, #F4F7FB 100%);
  padding: 16rpx 28rpx 24rpx;
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.today-date {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.01em;
}

.mode-badge {
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.mode-real {
  color: #1D4ED8;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(147, 197, 253, 0.75);
}

.mode-demo {
  color: #6D28D9;
  background: rgba(243, 232, 255, 0.9);
  border: 1rpx solid #DDD6FE;
}

.alert-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 62rpx;
  padding: 0 20rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  flex-shrink: 0;
}

.alert-pill-active {
  background: #FFFBEB;
  border-color: #FDE68A;
}

.pill-hover {
  opacity: 0.85;
}

.alert-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.alert-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.alert-count {
  font-size: 24rpx;
  font-weight: 700;
  color: #1D4ED8;
}

.alert-pill-active .alert-count {
  color: #D97706;
}

/* 核心血糖仪表卡片 */
.reading-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 28rpx 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 22rpx;
}

.current-reading {
  padding-top: 26rpx;
}

.reading-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reading-caption {
  font-size: 25rpx;
  font-weight: 600;
  color: #64748B;
}

.reading-link {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2563EB;
}

.mini-chevron {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.reading-number {
  display: flex;
  align-items: baseline;
  margin: 18rpx 0 14rpx;
}

.reading-number .number {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.05;
  color: #0F172A;
  letter-spacing: -0.03em;
}

.reading-number .number-empty {
  font-size: 70rpx;
  font-weight: 700;
  line-height: 1.05;
  color: #CBD5E1;
  letter-spacing: 2rpx;
}

.reading-number .unit {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
  margin-left: 10rpx;
}

.reading-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.reading-time {
  font-size: 25rpx;
  color: #64748B;
  line-height: 1.5;
}

.measure-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #0369A1;
  background: #F0F9FF;
  padding: 2rpx 14rpx;
  border-radius: 9999rpx;
}

.reading-footer {
  margin-top: 16rpx;
}

.today-count-pill {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 600;
  color: #1D4ED8;
  background: #EFF6FF;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
}

.reading-tip {
  font-size: 23rpx;
  color: #D97706;
  margin-top: 14rpx;
  line-height: 1.55;
}

/* 快捷操作双按钮 */
.quick-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quick-actions button {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 92rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.action-record {
  flex: 1.35;
}

.action-import {
  flex: 1;
  background: #FFFFFF;
  color: #1E293B;
  border: 1rpx solid #E2E8F0;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.action-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

/* 主体业务卡片区 */
.home-body {
  padding: 0 28rpx;
}

.section-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.045);
}

.card-hover {
  background: #FAFCFF;
}

.state-card {
  text-align: center;
  padding: 36rpx 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
}

.section-action {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #2563EB;
}

.section-desc {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
}

.med-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.med-stat {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
}

.med-taken {
  color: #047857;
  background: #ECFDF5;
}

.med-pending {
  color: #1D4ED8;
  background: #EFF6FF;
}

.med-skipped {
  color: #64748B;
  background: #F1F5F9;
}

.overview-grid {
  display: flex;
  gap: 16rpx;
}

.overview-tile {
  flex: 1;
  min-width: 0;
  background: #F8FAFC;
  border: 1rpx solid #EEF2F7;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.tile-label {
  font-size: 23rpx;
  color: #64748B;
  font-weight: 500;
}

.tile-value {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 8rpx;
}

.tile-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #0F172A;
  line-height: 1.1;
}

.tile-unit {
  font-size: 23rpx;
  color: #64748B;
}

.section-footnote {
  font-size: 23rpx;
  color: #94A3B8;
  margin-top: 16rpx;
  line-height: 1.5;
}
