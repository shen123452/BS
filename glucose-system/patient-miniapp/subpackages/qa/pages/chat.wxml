<view class="qa-page {{isTab ? 'qa-tab' : ''}}">
  <view class="qa-toolbar">
    <view class="qa-toolbar-left">
      <view class="toolbar-dot {{sessionId ? 'dot-active' : ''}}" />
      <view class="qa-toolbar-title">{{sessionId ? '当前对话' : '新对话'}}</view>
    </view>
    <view class="qa-tools">
      <button class="text-button toolbar-pill" disabled="{{generating || pendingRequest}}" bindtap="newConversation">+ 新对话</button>
      <button class="text-button toolbar-pill" bindtap="history">历史</button>
    </view>
  </view>

  <scroll-view scroll-y class="chat-scroll" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view wx:if="{{knowledgeHint}}" class="knowledge-hint">
      <image class="hint-icon" src="/assets/icons/qa-book.svg" mode="aspectFit" aria-hidden="true" />
      <text class="hint-text">{{knowledgeHint}}</text>
    </view>

    <view wx:if="{{!messages.length && !loading}}" class="qa-welcome">
      <view class="welcome-hero">
        <view class="hero-top">
          <view class="hero-badge">
            <image class="hero-badge-icon" src="/assets/icons/qa-sparkle.svg" mode="aspectFit" aria-hidden="true" />
          </view>
          <view class="hero-copy">
            <view class="qa-welcome-title">你好，我是血糖健康助手</view>
            <view class="qa-welcome-copy">回答基于审核健康资料并附上出处，资料不足时会明确说明。</view>
          </view>
        </view>
        <view class="hero-tags">
          <text class="hero-chip">资料可溯源</text>
          <text class="hero-chip">原文摘录可查</text>
          <text class="hero-chip">不替代临床诊断</text>
        </view>
      </view>

      <view class="suggestions-card">
        <view class="suggestions-header">
          <text class="suggestions-title">你可以这样问</text>
          <text class="suggestions-sub">点击填入问题</text>
        </view>
        <view class="question-suggestions">
          <block wx:for="{{suggestions}}" wx:key="*this">
            <view class="suggestion-row" hover-class="suggestion-row-hover" data-question="{{item}}" bindtap="chooseQuestion" role="button">
              <image class="suggestion-icon" src="/assets/icons/qa-prompt.svg" mode="aspectFit" aria-hidden="true" />
              <text class="suggestion-text">{{item}}</text>
              <image class="suggestion-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
            </view>
            <view wx:if="{{index < suggestions.length - 1}}" class="suggestion-divider" />
          </block>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && !messages.length}}" class="chat-status">正在加载对话…</view>

    <view wx:for="{{messages}}" wx:key="messageId" class="msg-row {{item.isUser ? 'row-user' : 'row-assistant'}}">
      <view wx:if="{{!item.isUser}}" class="msg-header">
        <view class="msg-avatar {{item.isHuman ? 'avatar-doctor' : 'avatar-ai'}}">
          <image wx:if="{{!item.isHuman}}" class="msg-avatar-icon" src="/assets/icons/qa-sparkle.svg" mode="aspectFit" aria-hidden="true" />
          <text wx:else class="msg-avatar-text">医</text>
        </view>
        <text class="msg-author">{{item.isHuman ? '医生回复' : '血糖助手'}}</text>
        <text wx:if="{{item.modeText}}" class="mode-pill {{item.isHuman ? 'mode-pill-human' : ''}}">{{item.modeText}}</text>
      </view>
      <view wx:else class="msg-author msg-author-user">我</view>

      <view class="msg-bubble {{item.isUser ? 'bubble-user' : 'bubble-assistant'}}">
        <view wx:if="{{item.isProcessing}}" class="processing-copy">正在查找资料并生成回答…</view>
        <block wx:elif="{{item.content}}">
          <text user-select>{{item.content}}</text>
          <text wx:if="{{item.isStreaming}}" class="stream-cursor" aria-hidden="true">▍</text>
        </block>
        <text wx:elif="{{item.status === 'FAILED'}}">本次回答未完成，请重试。</text>
      </view>

      <view wx:if="{{!item.isUser && item.hasSources}}" class="message-meta">
        <button class="text-button source-button" data-id="{{item.messageId}}" bindtap="viewSources">
          <image class="source-btn-icon" src="/assets/icons/qa-book.svg" mode="aspectFit" aria-hidden="true" />
          <text>查看引用资料</text>
        </button>
      </view>
    </view>

    <view wx:if="{{errorMsg}}" class="form-error chat-error">{{errorMsg}}</view>
    <button wx:if="{{errorMsg && sessionId && !pendingRequest}}" class="btn-plain reload-button" bindtap="loadMessages">重新加载对话</button>
    <button wx:if="{{pendingRequest}}" class="btn-plain reload-button" disabled="{{generating}}" bindtap="retry">{{generating ? '正在生成…' : '重试或查看上次结果'}}</button>
    <view id="msg-bottom" class="scroll-anchor"></view>
  </scroll-view>

  <view class="chat-composer">
    <view class="chat-input-bar">
      <input class="chat-input" value="{{input}}" bindinput="onInput" placeholder="输入血糖相关问题…" maxlength="500" confirm-type="send" bindconfirm="send" cursor-spacing="20" disabled="{{loading}}" />
      <button class="btn-primary chat-send" disabled="{{generating || loading || !input}}" bindtap="send">{{generating ? '生成中' : '发送'}}</button>
    </view>
    <view class="composer-note">健康知识参考，不替代医生诊断与治疗</view>
  </view>

  <view wx:if="{{visibleSources !== null}}" class="source-backdrop" bindtap="closeSources">
    <view class="source-sheet" catchtap="stopTap">
      <view class="sheet-handle" />
      <view class="source-sheet-heading">
        <view class="card-title">引用资料</view>
        <button class="text-button" bindtap="closeSources">关闭</button>
      </view>
      <scroll-view scroll-y class="source-scroll">
        <view wx:if="{{sourceLoading}}" class="chat-status">正在加载资料…</view>
        <view wx:elif="{{!visibleSources.length}}" class="chat-status">此回答暂无引用资料。</view>
        <view wx:for="{{visibleSources}}" wx:key="citationId" class="source-item">
          <view class="source-item-top">
            <text class="source-index">[{{item.citationId}}]</text>
            <text class="source-title">{{item.title}}</text>
          </view>
          <view class="source-origin">{{item.sourceTitle}} · {{item.sourceVersion}}</view>
          <text class="source-excerpt" user-select>{{item.excerpt || '历史回答未保存资料摘录'}}</text>
          <button wx:if="{{item.sourceUrl}}" class="text-button source-copy" data-index="{{index}}" bindtap="copySource">复制来源链接</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
