    {"name":"Primary Button","kind":"button","refersTo":"button-primary","description":"提交主要下一步操作。","html":"<button class=\"ds-btn-primary\">确认预约</button>","css":".ds-btn-primary{min-height:44px;padding:10px 16px;border:1px solid #1D4ED8;border-radius:8px;background:#1D4ED8;color:#FFFFFF;font:500 14px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;cursor:pointer}.ds-btn-primary:hover{background:#1E40AF}.ds-btn-primary:focus-visible{outline:3px solid #1D4ED8;outline-offset:3px}"},
    {"name":"Secondary Button","kind":"button","refersTo":"button-secondary","description":"返回、刷新或管理次要动作。","html":"<button class=\"ds-btn-secondary\">刷新列表</button>","css":".ds-btn-secondary{min-height:40px;padding:8px 16px;border:1px solid #7C8DA5;border-radius:8px;background:#FFFFFF;color:#475569;font:500 14px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;cursor:pointer}.ds-btn-secondary:hover{border-color:#1D4ED8;color:#1D4ED8}.ds-btn-secondary:focus-visible{outline:3px solid #1D4ED8;outline-offset:3px}"},
    {"name":"Panel","kind":"card","refersTo":"panel","description":"承载筛选、表单、列表和摘要的白色工作面。","html":"<section class=\"ds-panel\"><h2>门诊准备</h2><p>按顺序准备资料。</p></section>","css":".ds-panel{padding:24px;border:1px solid #D7DFEA;border-radius:12px;background:#FFFFFF;color:#0F172A}.ds-panel h2{margin:0;font:650 19px/1.45 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif}.ds-panel p{margin:8px 0 0;color:#475569;font:400 14px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif}"},
    {"name":"Input","kind":"input","refersTo":"input","description":"带可见标签的 Element Plus 风格字段。","html":"<label class=\"ds-field\">账号<input class=\"ds-input\" placeholder=\"请输入账号\"></label>","css":".ds-field{display:block;color:#0F172A;font:500 14px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif}.ds-input{display:block;width:100%;height:44px;margin-top:8px;padding:8px 12px;border:1px solid #7C8DA5;border-radius:8px;background:#FFFFFF;color:#0F172A;font:400 14px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif}.ds-input:focus{border-color:#1D4ED8;outline:3px solid #1D4ED8;outline-offset:1px}"},
    {"name":"Patient Navigation","kind":"nav","refersTo":"navigation","description":"患者顶部导航，当前路由由深蓝文字和底线标记。","html":"<nav class=\"ds-patient-nav\"><a class=\"current\" aria-current=\"page\">预约挂号</a><a>我的就诊</a></nav>","css":".ds-patient-nav{display:flex;gap:24px;height:64px;align-items:center}.ds-patient-nav a{color:#475569;text-decoration:none;line-height:64px}.ds-patient-nav a.current{color:#1D4ED8;font-weight:600;box-shadow:inset 0 -2px #1D4ED8}.ds-patient-nav a:focus-visible{outline:3px solid #1D4ED8;outline-offset:3px}"},
    {"name":"Status Badge","kind":"chip","refersTo":"status-badge","description":"文字加色面表达预约、接诊和提交状态。","html":"<span class=\"ds-status ds-status-open\">开放</span>","css":".ds-status{display:inline-flex;align-items:center;padding:3px 9px;border-radius:6px;font:500 13px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;white-space:nowrap}.ds-status-open{background:#DCFCE7;color:#166534}.ds-status-waiting{background:#FEF3C7;color:#92400E}.ds-status-progress{background:#DBEAFE;color:#1E40AF}"},
    {"name":"Schedule Card","kind":"card","refersTo":"panel","description":"患者预约场次的医生、时间、余号和选择动作。","html":"<article class=\"ds-schedule\"><strong>联调医生</strong><span>2026-10-14 · 上午</span><button class=\"ds-btn-primary\">选择场次</button></article>","css":".ds-schedule{display:flex;align-items:center;gap:24px;padding:24px;border:1px solid #D7DFEA;border-radius:12px;background:#FFFFFF;color:#0F172A;font:400 14px/1.65 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif}.ds-schedule strong{font-size:19px}.ds-schedule span{flex:1;color:#475569}.ds-schedule .ds-btn-primary{flex:none}"},
