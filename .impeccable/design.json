  "narrative": {
    "northStar": "临床工作台与日常记录",
    "overview": "临床管理工作台与患者日常记录共用蓝白视觉语言：浅灰画布、白色面板、清晰细边框、蓝色操作与克制的状态色。页面依靠真实内容、筛选和状态建立层级，产品事实与指标语义以 PRODUCT.md 为准。\n\n本记录依据实际 Vue/CSS 与 WXML/WXSS 提取，刷新已获授权的新原型实现；来源见 `docs/ui-implementation-2026-11-13/实现方向.md`。Figma 原始参考在 `docs/ui-prototypes/全套页面-2026-11-13/页面图片/`，代码是本文件记录值的依据。",
    "keyCharacteristics": [
      "蓝色主操作，白色内容层，浅灰画布。",
      "桌面紧凑表格，患者端触控与读数优先。",
      "来源、真实/演示和处理状态持续可辨。"
    ],
    "rules": [
      {
        "name": "Explicit Status",
        "body": "颜色辅助状态，文字明确来源、真实性和处理结果。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 使用现有颜色令牌，状态同时给出文字与颜色。",
      "Do 保留 SMBG/CGM、真实/演示、未配置目标与数据不足的明确区别。",
      "Do 在表格和读数中使用等宽数字，保留单位、时间与来源。",
      "Do 为加载、空、失败和部分数据保留说明；错误靠近操作并保留输入。"
    ],
    "donts": [
      "Don't 将本次 HTML 转译预览称为小程序原生验收。",
      "Don't 用颜色或正常色替代数据充分性和目标配置判断。",
      "Don't 把旧顶部桌面导航、旧蓝色或首页蓝色双读数头重新作为本轮主界面规范。"
    ]
  }
